# =============================================================================
# FGD Beauty Suite — variables de entorno (ejemplo)
# Copia este fichero a `.env` y rellena con valores reales.
# NUNCA subas `.env` al repositorio. Todos los secretos aquí son DUMMY.
# El arranque de la API valida estas variables con zod y falla si falta alguna.
# =============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# --- Base de datos / caché -------------------------------------------------
# PostgreSQL 16
DATABASE_URL=postgresql://fgd:fgd_dev_password@localhost:5432/fgd_beauty?schema=public
# Redis 7 (caché + colas BullMQ)
REDIS_URL=redis://localhost:6379

# --- Autenticación JWT -----------------------------------------------------
# DUMMY: genera secretos reales con `openssl rand -hex 32` en cada entorno.
JWT_ACCESS_SECRET=dummy_access_secret_change_me_0000000000000000000000000000
JWT_REFRESH_SECRET=dummy_refresh_secret_change_me_000000000000000000000000000
# TTL en segundos: access 15m, refresh 7d.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Dominio para las cookies httpOnly de sesión. IMPORTANTE: debe ser el dominio
# de la WEB (el BFF de Next reenvía Set-Cookie verbatim y el navegador aplica
# Domain contra el origen web, NO contra el del API). En producción usa el
# dominio registrable del sitio (p. ej. `.midominio.com`) o déjalo vacío para
# una cookie host-only pegada al host del BFF. Si aquí pones el subdominio del
# API mientras la web sirve en otro host, el navegador descarta la cookie y no
# hay sesión. En local: `localhost`.
COOKIE_DOMAIN=localhost

# --- CORS ------------------------------------------------------------------
# Allowlist separada por comas.
CORS_ORIGINS=http://localhost:3000

# --- Stripe (suscripciones + pagos) ---------------------------------------
# DUMMY: usa claves de test reales de tu cuenta Stripe.
STRIPE_SECRET_KEY=sk_test_dummy_stripe_secret_key_change_me
STRIPE_WEBHOOK_SECRET=whsec_dummy_stripe_webhook_secret_change_me

# --- Email -----------------------------------------------------------------
# Usa SMTP_URL (p. ej. Mailhog en local) o RESEND_API_KEY (producción). Uno u otro.
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=re_dummy_resend_api_key_change_me

# --- Plataforma / multi-tenancy -------------------------------------------
PLATFORM_DOMAIN=fgdbeauty.app
DEFAULT_TENANT_SLUG=aurora

# --- Frontend (Next.js — expuestas al navegador) --------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp del salón (formato internacional sin +). TODO: número real de Aurora.
NEXT_PUBLIC_WHATSAPP=34600000000
